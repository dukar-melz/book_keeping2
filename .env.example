# --- Supabase (required in production) ---
# Leave blank to fall back to local JSON files in memory/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=receipts

# --- Assistant (OpenRouter) ---
# Without a key the assistant still logs expenses from patterns such as
# "spent $50 at Starbucks for coffee", but it cannot answer questions.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated free model ids, tried in order until one works.
LLM_MODELS=
# Pin a single model while debugging; overrides LLM_MODELS.
LLM_MODEL=
LLM_ATTEMPTS=2
LLM_TIMEOUT_MS=45000

# --- Local development only ---
# Where the JSON memory store lives when Supabase is not configured.
PI_CODING_AGENT_DIR=
PORT=3000